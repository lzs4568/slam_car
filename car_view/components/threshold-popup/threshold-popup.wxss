.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 100;
}

.popup-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 36rpx 36rpx 56rpx;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0,0,0,0.1);
}

.popup-show {
  transform: translateY(0);
}

.popup-header {
  display: flex;
  align-items: baseline;
  margin-bottom: 36rpx;
}

.popup-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a22;
}

.popup-unit {
  font-size: 24rpx;
  color: #8e8e98;
  margin-left: 8rpx;
}

.threshold-row {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.threshold-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #6b6b78;
  width: 120rpx;
}

.threshold-input {
  flex: 1;
  border: 1rpx solid #d8dae0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a22;
  background: #f8f9fb;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.04);
}

.threshold-unit {
  font-size: 24rpx;
  color: #8e8e98;
  margin-left: 10rpx;
  width: 60rpx;
}

.popup-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f3f4f6;
  color: #6b6b78;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.04), inset 0 1rpx 0 rgba(255,255,255,0.8);
}

.btn-cancel::after { border: none; }

.btn-save {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(180deg, #4b8ef7 0%, #3b7de6 100%);
  color: #ffffff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 0;
  box-shadow: 0 4rpx 14rpx rgba(59,130,246,0.3), inset 0 1rpx 0 rgba(255,255,255,0.25);
}

.btn-save::after { border: none; }
