<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam_car_bringup</name>
  <version>0.0.0</version>
  <description>SLAM小车启动配置: 底盘驱动、传感器、SLAM一站式launch</description>
  <maintainer email="lzs4568@gmail.com">lzs4568</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>yahboomcar_bringup</exec_depend>
  <exec_depend>yahboomcar_base_node</exec_depend>
  <exec_depend>yahboomcar_ctrl</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>ydlidar_ros2_driver</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
